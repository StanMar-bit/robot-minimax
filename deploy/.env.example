# Copy to deploy/.env (never commit the real one).
IMAGE=ghcr.io/your-org/robot-minimax:latest
MINIMAX_HOST=minimax.example.nl
CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure

# Generate each with: openssl rand -base64 24
ADMIN_TOKEN=
BRIDGE_TOKEN=
DEVICE_HASH_SECRET=

# htpasswd -nbB ta 'a-strong-password'   -> double every $ for docker compose ($ -> $$)
ADMIN_HTPASSWD=

# 'robot' or 'sim' (no robot) at startup; the admin panel can switch at any time
ROBOT_MODE=sim
